generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  PLAYER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum BalanceTransactionType {
  CREDIT
  DEBIT
  ADJUSTMENT
  REVERSAL
}

enum NotificationType {
  FUNDS_RECEIVED
  ACCOUNT_SUSPENDED
  ACCOUNT_UPDATED
  ACCOUNT_REASSIGNED
  SUSPICIOUS_LOGIN
}

enum NotificationCategory {
  FINANCE
  ACCOUNT
  SECURITY
  SYSTEM
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum BalanceTransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String     @id @default(cuid())
  clerkId   String     @unique @map("clerk_id")
  username  String     @unique
  /// AES-256-GCM ciphertext — never returned by API. Not unique (randomized IV).
  emailCipher String   @map("email_cipher")
  /// HMAC blind index for uniqueness/lookup without storing plaintext email.
  emailHash   String   @unique @map("email_hash")
  role      Role
  parentId  String?    @map("parent_id")
  parent    User?      @relation("UserHierarchy", fields: [parentId], references: [id])
  children  User[]     @relation("UserHierarchy")
  status    UserStatus @default(ACTIVE)
  balance   Decimal    @default(0) @db.Decimal(12, 2)
  balanceLimit Decimal  @default(1000000) @map("balance_limit") @db.Decimal(12, 2)
  managerCapacity Int    @default(100) @map("manager_capacity")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  auditLogsAsActor  AuditLog[] @relation("AuditActor")
  auditLogsAsTarget AuditLog[] @relation("AuditTarget")
  balanceTransactionsAsManager BalanceTransaction[] @relation("BalanceManager")
  balanceTransactionsAsActor   BalanceTransaction[] @relation("BalanceActor")
  balanceTransactionsApproved  BalanceTransaction[] @relation("BalanceApprover")
  notifications                Notification[]
  notificationPreference      NotificationPreference?
  loginHistory                 LoginHistory[]

  @@index([parentId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model LoginHistory {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String   @unique @map("session_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  device      String?
  browser     String?
  location    String?
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("login_history")
}

model SecuritySetting {
  id          String   @id @default("default")
  failLimit   Int      @default(8) @map("fail_limit")
  windowMs    Int      @default(900000) @map("window_ms")
  banMs       Int      @default(3600000) @map("ban_ms")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("security_settings")
}

model CommissionSetting {
  id        String   @id @default("default")
  percentage Decimal @default(0) @db.Decimal(5, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("commission_settings")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  category  NotificationCategory @default(SYSTEM)
  severity  NotificationSeverity @default(INFO)
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?        @map("read_at")
  archivedAt DateTime?       @map("archived_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, readAt, archivedAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inAppEnabled    Boolean  @default(true) @map("in_app_enabled")
  emailEnabled    Boolean  @default(false) @map("email_enabled")
  financeEnabled  Boolean  @default(true) @map("finance_enabled")
  accountEnabled  Boolean  @default(true) @map("account_enabled")
  securityEnabled Boolean  @default(true) @map("security_enabled")
  systemEnabled   Boolean  @default(true) @map("system_enabled")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model BalanceTransaction {
  id        String                  @id @default(cuid())
  managerId String                  @map("manager_id")
  manager   User                   @relation("BalanceManager", fields: [managerId], references: [id], onDelete: Cascade)
  actorId   String?                 @map("actor_id")
  actor     User?                  @relation("BalanceActor", fields: [actorId], references: [id], onDelete: SetNull)
  approvedById String?             @map("approved_by_id")
  approvedBy User?                 @relation("BalanceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  type      BalanceTransactionType
  amount    Decimal                 @db.Decimal(12, 2)
  reason    String
  status    BalanceTransactionStatus @default(APPROVED)
  approvedAt DateTime?              @map("approved_at")
  createdAt DateTime                @default(now()) @map("created_at")

  @@index([managerId, createdAt])
  @@index([actorId])
  @@map("balance_transactions")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  action    String
  targetId  String?  @map("target_id")
  target    User?    @relation("AuditTarget", fields: [targetId], references: [id])
  ipAddress String?  @map("ip_address")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Event {
  id        String      @id @default(cuid())
  name      String
  league    String
  status    EventStatus @default(UPCOMING)
  startsAt  DateTime
  volume    Decimal     @default(0) @db.Decimal(12, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, startsAt])
}

enum EventStatus {
  LIVE
  UPCOMING
  COMPLETED
}
