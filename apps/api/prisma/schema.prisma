generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  PLAYER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum BalanceTransactionType {
  /// A real transfer down the hierarchy: fromUser's balance decreases,
  /// toUser's balance increases by the same amount.
  DELEGATION
  /// The reverse of a delegation: a parent pulls credit back from a direct
  /// child. fromUser is the child (balance decreases), toUser is the parent
  /// (balance increases, except Super Admin, who holds no balance — credit
  /// reclaimed by Super Admin is retired).
  RECLAIM
  /// Super-Admin-only correction. fromUserId is always null (nothing is
  /// deducted from anyone else); amount may be negative.
  ADJUSTMENT
  /// A Player placing a bet: the stake leaving their balance. toUserId is the
  /// Player, fromUserId is null, amount is negative, betId is set.
  BET_STAKE
  /// Settlement moving a bet's money: winnings, a refund, or a correction
  /// taking back a payout. toUserId is the Player, amount is the change
  /// (negative when a payout is taken back), betId is set.
  BET_SETTLEMENT
  /// A Player's casino play for one day (Albanian time): one line per Player
  /// per day, updated with every spin, so the ledger always adds up to the
  /// balance. amount is the day's net (wins minus stakes). The spins
  /// themselves are in casino_spins.
  CASINO
}

enum NotificationType {
  FUNDS_RECEIVED
  FUNDS_RECLAIMED
  APPROVAL_REQUESTED
  ACCOUNT_SUSPENDED
  ACCOUNT_UPDATED
  ACCOUNT_REASSIGNED
  SUSPICIOUS_LOGIN
  COMMISSION_RATE_UPDATED
  LOW_BALANCE
  BET_SETTLED
}

enum NotificationCategory {
  FINANCE
  ACCOUNT
  SECURITY
  SYSTEM
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum BalanceTransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                   String     @id @default(cuid())
  clerkId              String     @unique @map("clerk_id")
  username             String     @unique
  /// AES-256-GCM ciphertext — never returned by API. Not unique (randomized IV).
  emailCipher          String     @map("email_cipher")
  /// HMAC blind index for uniqueness/lookup without storing plaintext email.
  emailHash            String     @unique @map("email_hash")
  role                 Role
  parentId             String?    @map("parent_id")
  parent               User?      @relation("UserHierarchy", fields: [parentId], references: [id])
  children             User[]     @relation("UserHierarchy")
  status               UserStatus @default(ACTIVE)
  /// Delegatable credit this user currently holds. Every role except
  /// SUPER_ADMIN carries a real balance in the delegation model — Super Admin
  /// "prints" credit into an Owner's balance with no source deduction.
  balance              Decimal    @default(0) @db.Decimal(12, 2)
  balanceLimit         Decimal    @default(1000000) @map("balance_limit") @db.Decimal(12, 2)
  /// Max number of direct Players this user (Owner or Manager) may hold.
  managerCapacity      Int        @default(100) @map("manager_capacity")
  /// Percentage this user's commission relationship with their parent runs
  /// at: for an OWNER, the cut Super Admin takes from their net revenue; for
  /// a MANAGER, the cut they earn from their own downline Players' net
  /// revenue. Unused for SUPER_ADMIN/PLAYER.
  commissionRate       Decimal    @default(0) @map("commission_rate") @db.Decimal(5, 2)
  /// MANAGER only: this Manager's own delegations up to this amount go through
  /// without their Owner's approval. Null means the platform default ($10,000).
  /// Set by the Manager's Owner (or Super Admin).
  approvalLimit        Decimal?   @map("approval_limit") @db.Decimal(12, 2)
  /// OWNER only: the approval limit every Manager in this team gets unless
  /// they have their own approvalLimit. Null means the platform default.
  managerApprovalLimit Decimal?   @map("manager_approval_limit") @db.Decimal(12, 2)
  /// OWNER only: alert when a Manager or Player in this team drops below this
  /// balance. Null turns low-balance alerts off.
  lowBalanceThreshold  Decimal?   @map("low_balance_threshold") @db.Decimal(12, 2)
  /// OWNER only: percent added to Super Admin's base margin for this team's
  /// prices. Negative gives the team better odds, but never above the feed.
  oddsMargin           Decimal    @default(0) @map("odds_margin") @db.Decimal(5, 2)
  /// OWNER only: the most this team's open bets may pay out if any one
  /// outcome wins (singles on it plus accumulators that include it). Null
  /// means no cap. New bets that would go over it are refused.
  maxOutcomePayout     Decimal?   @map("max_outcome_payout") @db.Decimal(12, 2)
  /// OWNER only: the Casino tab is open to this team (and the site's own
  /// switch, PlatformSettings.casinoEnabled, is on too).
  casinoEnabled        Boolean    @default(false) @map("casino_enabled")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  auditLogsAsActor       AuditLog[]              @relation("AuditActor")
  auditLogsAsTarget      AuditLog[]              @relation("AuditTarget")
  delegationsGiven       BalanceTransaction[]    @relation("DelegationFrom")
  delegationsReceived    BalanceTransaction[]    @relation("DelegationTo")
  delegationsActedOn     BalanceTransaction[]    @relation("DelegationActor")
  delegationsApproved    BalanceTransaction[]    @relation("DelegationApprover")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  loginHistory           LoginHistory[]
  bets                   Bet[]
  betsAsOwner            Bet[]                   @relation("BetOwner")
  betsAsManager          Bet[]                   @relation("BetManager")
  settlementsAsPlayer    SettlementEntry[]       @relation("SettlementPlayer")
  settlementsAsOwner     SettlementEntry[]       @relation("SettlementOwner")
  settlementsAsManager   SettlementEntry[]       @relation("SettlementManager")
  bettingLimit           BettingLimit?
  oddsOverrides          OddsOverride[]
  commissionPayouts      CommissionPayout[]
  casinoSpins            CasinoSpin[]
  casinoFreeSpins        CasinoFreeSpins?
  casinoGamble           CasinoGamble?
  blackjackHand          BlackjackHand?
  bookFeature            CasinoBookFeature?

  @@index([parentId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model LoginHistory {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String   @unique @map("session_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  device     String?
  browser    String?
  location   String?
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("login_history")
}

model SecuritySetting {
  id        String   @id @default("default")
  failLimit Int      @default(8) @map("fail_limit")
  windowMs  Int      @default(900000) @map("window_ms")
  banMs     Int      @default(3600000) @map("ban_ms")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("security_settings")
}

model Notification {
  id         String               @id @default(cuid())
  userId     String               @map("user_id")
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  category   NotificationCategory @default(SYSTEM)
  severity   NotificationSeverity @default(INFO)
  title      String
  message    String
  metadata   Json?
  readAt     DateTime?            @map("read_at")
  archivedAt DateTime?            @map("archived_at")
  createdAt  DateTime             @default(now()) @map("created_at")

  @@index([userId, readAt, archivedAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inAppEnabled    Boolean  @default(true) @map("in_app_enabled")
  emailEnabled    Boolean  @default(false) @map("email_enabled")
  financeEnabled  Boolean  @default(true) @map("finance_enabled")
  accountEnabled  Boolean  @default(true) @map("account_enabled")
  securityEnabled Boolean  @default(true) @map("security_enabled")
  systemEnabled   Boolean  @default(true) @map("system_enabled")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

/// A single entry in the delegation ledger. DELEGATION rows always have
/// fromUserId set (a real transfer, one-directional — the giver's balance
/// decreases, the receiver's increases). ADJUSTMENT rows have fromUserId
/// null (a Super-Admin-only correction with no counterparty) and amount may
/// be negative.
///
/// Ledger entries, bets and commission payouts are never deleted with a user:
/// every relation to User is Restrict, so an account with any money history
/// can only be suspended (UsersService.deleteUser refuses it first).
model BalanceTransaction {
  id               String                   @id @default(cuid())
  fromUserId       String?                  @map("from_user_id")
  fromUser         User?                    @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUserId         String                   @map("to_user_id")
  toUser           User                     @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Restrict)
  actorId          String?                  @map("actor_id")
  actor            User?                    @relation("DelegationActor", fields: [actorId], references: [id], onDelete: Restrict)
  approvedById     String?                  @map("approved_by_id")
  approvedBy       User?                    @relation("DelegationApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  type             BalanceTransactionType
  amount           Decimal                  @db.Decimal(12, 2)
  reason           String
  status           BalanceTransactionStatus @default(APPROVED)
  approvedAt       DateTime?                @map("approved_at")
  /// BET_STAKE and BET_SETTLEMENT only: the bet this money moved for.
  betId            String?                  @map("bet_id")
  bet              Bet?                     @relation(fields: [betId], references: [id], onDelete: SetNull)
  createdAt        DateTime                 @default(now()) @map("created_at")
  commissionPayout CommissionPayout?

  @@index([toUserId, createdAt])
  @@index([fromUserId])
  @@index([status])
  @@index([betId])
  @@map("balance_transactions")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  action    String
  targetId  String?  @map("target_id")
  target    User?    @relation("AuditTarget", fields: [targetId], references: [id])
  ipAddress String?  @map("ip_address")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Event {
  id                 String      @id @default(cuid())
  /// "football"; "greyhounds" for a greyhound race (league = the track,
  /// country = GB, IE or AU); "mma" for a fight (league = the card,
  /// country = the weight class, home/away team = the fighters); "tennis"
  /// for a match (league = the tournament, country = the tour and round,
  /// home/away team = the players, home/away score = sets won).
  sport              String      @default("football")
  name               String
  league             String
  status             EventStatus @default(UPCOMING)
  startsAt           DateTime
  volume             Decimal     @default(0) @db.Decimal(12, 2)
  /// Where the match came from: "api-football", "mock" or "manual".
  provider           String      @default("manual")
  /// The match's id at the provider. Null for manual events.
  externalId         String?     @map("external_id")
  country            String?
  homeTeam           String?     @map("home_team")
  awayTeam           String?     @map("away_team")
  homeScore          Int?        @map("home_score")
  awayScore          Int?        @map("away_score")
  /// Minutes played, while live.
  elapsed            Int?
  /// The feed's phase while live: "1H", "HT" (half-time), "2H", "ET", "BT" (break before extra time), "P", "SUSP", "INT".
  period             String?
  /// When the feed first reported the match finished; it stays on the live list for a few minutes after, marked "Full time".
  finishedAt         DateTime?   @map("finished_at")
  /// Super Admin: hidden events aren't shown to anyone else.
  hidden             Boolean     @default(false)
  /// Super Admin: suspended events are shown but can't be bet on.
  suspended          Boolean     @default(false)
  /// Last time the provider sent anything for this event.
  syncedAt           DateTime?   @map("synced_at")
  /// Last time live odds arrived for this match. Live bets pause when this goes stale.
  liveOddsAt         DateTime?   @map("live_odds_at")
  /// The feed has stopped live betting on this match (e.g. a goal or VAR check).
  liveStopped        Boolean     @default(false) @map("live_stopped")
  /// Live bets pause until then after a goal, a big price jump or a reopen (see odds/live-guard.ts).
  liveCooldownUntil  DateTime?   @map("live_cooldown_until")
  /// Why: goal, swing or reopen.
  liveCooldownReason String?     @map("live_cooldown_reason")
  /// The score bets are settled on: 90 minutes plus stoppage time, never
  /// extra time or penalties. Set by the feed when the match ends, or by
  /// Super Admin when correcting a result.
  resultHome         Int?        @map("result_home")
  resultAway         Int?        @map("result_away")
  /// The half-time score, for the 1st and 2nd half markets.
  resultHalfHome     Int?        @map("result_half_home")
  resultHalfAway     Int?        @map("result_half_away")
  /// Went to extra time or penalties: match statistics include extra time then, so corner and card bets wait for Super Admin.
  extraTime          Boolean     @default(false) @map("extra_time")
  /// Corners and cards (every yellow and red counts as one) the corner and card markets settle on.
  resultCornersHome  Int?        @map("result_corners_home")
  resultCornersAway  Int?        @map("result_corners_away")
  resultCardsHome    Int?        @map("result_cards_home")
  resultCardsAway    Int?        @map("result_cards_away")
  /// "feed" or "manual". The feed never overwrites numbers Super Admin entered.
  statsSource        String?     @map("stats_source")
  /// Last time the feed was asked for this match's statistics.
  statsCheckedAt     DateTime?   @map("stats_checked_at")
  /// The goals in the 90 minutes, in order, and who took part (see bets/goals.ts),
  /// for the first/last team to score, comeback and goalscorer markets.
  resultGoals        Json?       @map("result_goals")
  /// Last time the feed was asked for this match's goals.
  goalsCheckedAt     DateTime?   @map("goals_checked_at")
  /// Greyhounds: the race's details (number, grade, distance, region) and,
  /// once it's run, its official result (see odds/greyhounds.ts).
  race               Json?
  raceResult         Json?       @map("race_result")
  /// When bets close, if before the start: an MMA fight closes when its
  /// card's first fight starts (fights often go on earlier than listed).
  closesAt           DateTime?   @map("closes_at")
  /// MMA: who won, how, in which round and at what time (see odds/mma.ts).
  /// Tennis: who won, every set's games, and whether a player retired (see odds/tennis.ts).
  fightResult        Json?       @map("fight_result")
  /// "feed" or "manual". The feed never overwrites a manual result.
  resultSource       String?     @map("result_source")
  /// When the feed last changed a result bets were already settled on. Once
  /// it has stayed the same for a while, settlement re-settles the bets and clears this.
  resultChangedAt    DateTime?   @map("result_changed_at")
  /// When the feed moved kick-off more than 48 hours later. Open bets placed
  /// before then are refunded, and this is cleared.
  rescheduledAt      DateTime?   @map("rescheduled_at")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  markets            Market[]

  @@unique([provider, externalId])
  @@index([status, startsAt])
  @@index([sport, status, startsAt])
}

/// One bet type on an event, e.g. "Match winner" or "Total goals 2.5".
model Market {
  id            String      @id @default(cuid())
  eventId       String      @map("event_id")
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Stable key such as "match_winner" or "goals_2_5".
  key           String
  name          String
  sortOrder     Int         @default(0) @map("sort_order")
  /// While the match is live: the feed suspended this market, or stopped pricing it.
  liveSuspended Boolean     @default(false) @map("live_suspended")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  selections    Selection[]

  @@unique([eventId, key])
  /// Each match's main market (its first) for the match list.
  @@index([eventId, sortOrder])
  @@map("markets")
}

/// One outcome in a market, e.g. "Home" or "Over 2.5".
model Selection {
  id           String           @id @default(cuid())
  marketId     String           @map("market_id")
  market       Market           @relation(fields: [marketId], references: [id], onDelete: Cascade)
  /// Stable key such as "home", "draw" or "over".
  key          String
  name         String
  /// The price from the feed, before any margin or override.
  feedOdds     Decimal          @map("feed_odds") @db.Decimal(8, 2)
  /// The in-play price from the feed, while the match is live. Owners' fixed prices don't apply to it.
  liveOdds     Decimal?         @map("live_odds") @db.Decimal(8, 2)
  /// Set when the market is settled.
  result       SelectionResult?
  /// "manual" when Super Admin settled this outcome by hand; settlement then keeps it.
  resultSource String?          @map("result_source")
  /// The feed stopped pricing this outcome while still pricing the rest of its market (a player left out of the squad, a line taken down). No bets until it's back.
  withdrawn    Boolean          @default(false)
  /// Greyhounds: the dog's trap and trainer (Winner), or both dogs' traps (Forecast).
  info         Json?
  sortOrder    Int              @default(0) @map("sort_order")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  overrides    OddsOverride[]
  bets         Bet[]
  legs         BetLeg[]
  history      OddsSnapshot[]

  @@unique([marketId, key])
  @@map("selections")
}

enum SelectionResult {
  WON
  LOST
  VOID
}

/// A pre-match feed price at a point in time, so a Player or Owner can see how a
/// price has moved rather than only its current value. Written on the regular
/// (10-minute) sync, not the 30-second live loop, and only when the price actually
/// changed — so this stays a sparse "change log," not a row every sync.
model OddsSnapshot {
  id          String    @id @default(cuid())
  selectionId String    @map("selection_id")
  selection   Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  price       Decimal   @db.Decimal(8, 2)
  recordedAt  DateTime  @default(now()) @map("recorded_at")

  @@index([selectionId, recordedAt])
  @@map("odds_snapshots")
}

/// An Owner's own price for one selection. Applies to their team only and
/// replaces the margin-adjusted feed price.
model OddsOverride {
  ownerId     String    @map("owner_id")
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  selectionId String    @map("selection_id")
  selection   Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  odds        Decimal   @db.Decimal(8, 2)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@id([ownerId, selectionId])
  @@index([selectionId])
  @@map("odds_overrides")
}

/// Platform-wide settings. There is one row, with id "default".
model PlatformSettings {
  id               String    @id @default("default")
  /// Super Admin's margin, in percent, taken off every feed price for every team.
  baseOddsMargin   Decimal   @default(0) @map("base_odds_margin") @db.Decimal(5, 2)
  /// When the odds feed last finished a sync, and what it reported.
  oddsSyncedAt     DateTime? @map("odds_synced_at")
  oddsSyncStatus   String?   @map("odds_sync_status") @db.VarChar(300)
  /// Super Admin's pick of competitions to sync: { leagues: number[], countries: string[] }.
  /// Null means the defaults (API_FOOTBALL_LEAGUES / API_FOOTBALL_COUNTRIES, or the built-in list).
  oddsCompetitions Json?     @map("odds_competitions")
  /// Super Admin's switch for the Casino tab on the whole site. Each Owner has their own too.
  casinoEnabled    Boolean   @default(false) @map("casino_enabled")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// A Player's bet. Commission reporting reads only settled bets (WON/LOST):
/// the house's net revenue from a bet is stake - payout, so a lost bet
/// earns the full stake and a won bet costs the winnings. VOID bets are
/// refunded and count for nothing.
model Bet {
  id          String               @id @default(cuid())
  playerId    String               @map("player_id")
  player      User                 @relation(fields: [playerId], references: [id], onDelete: Restrict)
  stake       Decimal              @db.Decimal(12, 2)
  /// What the Player was paid back, stake included. 0 for a lost bet.
  payout      Decimal              @default(0) @db.Decimal(12, 2)
  status      BetStatus            @default(OPEN)
  /// What was bet on, e.g. "Tirana v Partizani · Tirana to win".
  description String?              @db.VarChar(200)
  /// The price the Player got, locked when the bet was placed. For a bet
  /// paid at the starting price (greyhounds) it's set when the bet settles.
  odds        Decimal?             @db.Decimal(8, 2)
  /// Greyhounds: the bet is paid at the starting price (or the forecast
  /// dividend), less `spMargin` percent, never above `spCap`. The cap is what
  /// the team's open payouts count it at until then.
  spCap       Decimal?             @map("sp_cap") @db.Decimal(8, 2)
  spMargin    Decimal?             @map("sp_margin") @db.Decimal(5, 2)
  selectionId String?              @map("selection_id")
  selection   Selection?           @relation(fields: [selectionId], references: [id], onDelete: Restrict)
  placedAt    DateTime             @default(now()) @map("placed_at")
  settledAt   DateTime?            @map("settled_at")
  /// Set when Super Admin voided the bet by hand. Such a bet stays void even
  /// if the match result is corrected later.
  voidReason  String?              @map("void_reason") @db.VarChar(200)
  /// SINGLE bets point at one selection. ACCUMULATOR bets have legs, and
  /// `odds` is the combined price locked when the bet was placed.
  kind        BetKind              @default(SINGLE)
  legs        BetLeg[]
  /// The stake and every settlement move, in the Player's balance ledger.
  ledger      BalanceTransaction[]
  /// The team that took the bet and the commission rates in force when it was
  /// placed. Commission is worked out from these, so moving the Player to
  /// another Manager or changing a rate later never rewrites past results.
  /// Null only on bets placed before this was recorded (filled in on start).
  ownerId     String?              @map("owner_id")
  owner       User?                @relation("BetOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  /// Null when the Player sat directly under the Owner.
  managerId   String?              @map("manager_id")
  manager     User?                @relation("BetManager", fields: [managerId], references: [id], onDelete: Restrict)
  /// Super Admin's cut of the Owner's profit, in percent.
  ownerRate   Decimal?             @map("owner_rate") @db.Decimal(5, 2)
  /// The Manager's cut of their Players' profit, in percent (0 without a Manager).
  managerRate Decimal?             @map("manager_rate") @db.Decimal(5, 2)
  /// What each settlement did to the team's numbers, see SettlementEntry.
  settlements SettlementEntry[]

  @@index([playerId, settledAt])
  @@index([status, settledAt])
  @@index([selectionId])
  @@index([ownerId])
  @@index([managerId])
  @@map("bets")
}

/// Per-Player betting limits in two layers. The Owner (or Super Admin) sets
/// the ceiling; the Player's Manager can only tighten it. The limit that
/// applies is the lower of the two for each value. Null means no limit.
model BettingLimit {
  playerId              String   @id @map("player_id")
  player                User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  ownerMaxStake         Decimal? @map("owner_max_stake") @db.Decimal(12, 2)
  ownerDailyLossLimit   Decimal? @map("owner_daily_loss_limit") @db.Decimal(12, 2)
  managerMaxStake       Decimal? @map("manager_max_stake") @db.Decimal(12, 2)
  managerDailyLossLimit Decimal? @map("manager_daily_loss_limit") @db.Decimal(12, 2)
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("betting_limits")
}

enum BetKind {
  SINGLE
  ACCUMULATOR
}

/// One pick in an accumulator. Every leg must win for the bet to win; a void
/// leg drops out and the rest pay at their own prices.
model BetLeg {
  id          String           @id @default(cuid())
  betId       String           @map("bet_id")
  bet         Bet              @relation(fields: [betId], references: [id], onDelete: Cascade)
  selectionId String           @map("selection_id")
  selection   Selection        @relation(fields: [selectionId], references: [id], onDelete: Restrict)
  /// This leg's price, locked when the bet was placed.
  odds        Decimal          @db.Decimal(8, 2)
  description String           @db.VarChar(200)
  result      SelectionResult?
  /// Set when Super Admin voided this leg's match by hand; it stays void.
  voidReason  String?          @map("void_reason") @db.VarChar(200)
  sortOrder   Int              @default(0) @map("sort_order")

  @@index([betId])
  @@index([selectionId])
  @@map("bet_legs")
}

enum BetStatus {
  OPEN
  WON
  LOST
  VOID
}

enum EventStatus {
  LIVE
  UPCOMING
  COMPLETED
  POSTPONED
  CANCELLED
}

/// What one settlement did to a team's numbers, dated when it happened. A
/// bet settling adds its stake and payout; a correction later adds only the
/// difference, in the week it's made, so a week that has been reported and
/// paid never changes afterwards. Only WON and LOST bets count (a void one
/// is refunded), so voiding a settled bet takes it back out:
///   settled LOST       -> +1 bet, +stake, +0
///   corrected to WON   ->  0,      0,     +payout
///   voided             -> -1 bet, -stake, -payout
/// Summing a bet's rows gives what it counts for now. Team and rates are
/// copied from the bet, as they were when it was placed.
model SettlementEntry {
  id           String      @id @default(cuid())
  /// The bet this row is about; null for a casino spin.
  betId        String?     @map("bet_id")
  bet          Bet?        @relation(fields: [betId], references: [id], onDelete: Restrict)
  /// The casino spin this row is about; null for a bet. Spins count 0 bets.
  casinoSpinId String?     @map("casino_spin_id")
  casinoSpin   CasinoSpin? @relation(fields: [casinoSpinId], references: [id], onDelete: Restrict)
  playerId     String      @map("player_id")
  player       User        @relation("SettlementPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  ownerId      String?     @map("owner_id")
  owner        User?       @relation("SettlementOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  managerId    String?     @map("manager_id")
  manager      User?       @relation("SettlementManager", fields: [managerId], references: [id], onDelete: Restrict)
  ownerRate    Decimal     @default(0) @map("owner_rate") @db.Decimal(5, 2)
  managerRate  Decimal     @default(0) @map("manager_rate") @db.Decimal(5, 2)
  /// Change in settled bets counted: +1, -1 or 0.
  bets         Int
  /// Change in stakes and payouts counted.
  stake        Decimal     @db.Decimal(12, 2)
  payout       Decimal     @db.Decimal(12, 2)
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([ownerId, createdAt])
  @@index([managerId, createdAt])
  @@index([playerId, createdAt])
  @@index([betId])
  @@map("settlement_entries")
}

/// One row per client-supplied Idempotency-Key, so a double tap or a retried
/// request replays the first response instead of moving money twice.
model IdempotencyKey {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  key          String
  requestHash  String   @map("request_hash")
  completed    Boolean  @default(false)
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// A commission paid for one period: Super Admin collecting their cut from an
/// Owner (a RECLAIM), or an Owner paying a Manager (a DELEGATION). Recorded in
/// the same database transaction as the money moving, so a period can never be
/// paid twice: a new payout whose period overlaps an existing one is refused,
/// unless that one's transaction was rejected.
model CommissionPayout {
  id            String             @id @default(cuid())
  /// The Owner who paid Super Admin, or the Manager who was paid.
  userId        String             @map("user_id")
  user          User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// [periodFrom, periodTo): the settled bets this commission was worked out from.
  periodFrom    DateTime           @map("period_from")
  periodTo      DateTime           @map("period_to")
  amount        Decimal            @db.Decimal(12, 2)
  transactionId String             @unique @map("transaction_id")
  transaction   BalanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([userId, periodFrom])
  @@map("commission_payouts")
}

/// One casino spin: what it cost, what it paid, and exactly how the reels
/// landed, so any spin can be checked later. The team and rates are recorded
/// like a bet's, for the settlement journal and the Casino page's figures.
/// A spin, one guess at double or nothing (kind GAMBLE: bet and stake are the win at risk),
/// a round of roulette (kind ROULETTE: bet and stake are all the chips on the table),
/// or a round of blackjack (kind BLACKJACK: bet is the first bet, stake everything put down, doubles, splits and insurance included).
model CasinoSpin {
  id           String            @id @default(cuid())
  kind         CasinoPlayKind    @default(SPIN)
  playerId     String            @map("player_id")
  player       User              @relation(fields: [playerId], references: [id], onDelete: Restrict)
  ownerId      String?           @map("owner_id")
  managerId    String?           @map("manager_id")
  ownerRate    Decimal           @default(0) @map("owner_rate") @db.Decimal(5, 2)
  managerRate  Decimal           @default(0) @map("manager_rate") @db.Decimal(5, 2)
  /// The bet the spin was played at. A free spin plays at the bet that won it.
  bet          Decimal           @db.Decimal(12, 2)
  /// What it took from the balance: the bet, or 0 for a free spin.
  stake        Decimal           @db.Decimal(12, 2)
  win          Decimal           @db.Decimal(12, 2)
  free         Boolean           @default(false)
  freeSpinsWon Int               @default(0) @map("free_spins_won")
  /// grid[reel][row], where each reel stopped on its strip, and the winning lines. Empty for a guess.
  grid         Json
  stops        Json
  lines        Json
  /// A guess: the colour picked and the card drawn, { pick, suit }.
  gamble       Json?
  /// A roulette round: the number and every bet, { number, bets: [{ spot, amount, numbers, win }] }. stops holds the wheel's stop.
  roulette     Json?
  /// A blackjack round: every card dealt, each hand's moves and result, and the rest of the shoe.
  blackjack    Json?
  createdAt    DateTime          @default(now()) @map("created_at")
  settlements  SettlementEntry[]

  @@index([playerId, createdAt])
  @@index([ownerId, createdAt])
  @@index([managerId, createdAt])
  @@map("casino_spins")
}

enum CasinoPlayKind {
  SPIN
  GAMBLE
  ROULETTE
  BLACKJACK
  /// Book of Ra: a paid spin or a free one (see `free`).
  BOOK
}

/// A blackjack round still being played: one per Player at most. The stakes
/// already left the balance; the round is recorded as a CasinoSpin when it
/// ends, and this row goes. The shoe is in `state`, so it never leaves the
/// server. The team and rates are taken when the round is dealt.
model BlackjackHand {
  playerId    String   @id @map("player_id")
  player      User     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  ownerId     String?  @map("owner_id")
  managerId   String?  @map("manager_id")
  ownerRate   Decimal  @default(0) @map("owner_rate") @db.Decimal(5, 2)
  managerRate Decimal  @default(0) @map("manager_rate") @db.Decimal(5, 2)
  /// What the round has taken from the balance so far.
  staked      Decimal  @db.Decimal(12, 2)
  state       Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("blackjack_hands")
}

/// A win a Player can still take to double or nothing: how much is at risk, and how many guesses they've made.
model CasinoGamble {
  playerId  String   @id @map("player_id")
  player    User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// The game whose win this is: "slot" (Sizzling Hot) or "book" (Book of Ra).
  game      String   @default("slot")
  amount    Decimal  @db.Decimal(12, 2)
  steps     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("casino_gambles")
}

/// Free spins a Player has won and not played yet, and the bet they play at.
model CasinoFreeSpins {
  playerId  String   @id @map("player_id")
  player    User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  remaining Int
  bet       Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("casino_free_spins")
}

/// A Player's round of Book of Ra free spins in progress: kept between
/// requests, so each free spin is its own request and nothing is lost if the
/// Player leaves. Gone once the round ends.
model CasinoBookFeature {
  playerId  String   @id @map("player_id")
  player    User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// The bet of the spin that started it; every free spin plays at it.
  bet       Decimal  @db.Decimal(12, 2)
  /// The symbol that expands this round.
  special   String
  remaining Int
  played    Int      @default(0)
  /// What the round has paid so far, the spin that started it included (for the MAX_WIN cap).
  won       Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("casino_book_features")
}
