DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bastal?schema=public"
# Database connections the API keeps open (default 20). A `connection_limit=` in DATABASE_URL wins over this.
# DATABASE_POOL_SIZE=20
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_API_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:3000"
SENTRY_DSN=""
# Error reporting from the web app (browser and server). Can be the same DSN; set it on Vercel.
NEXT_PUBLIC_SENTRY_DSN=""
NODE_ENV="development"

# Clerk — identity only (not orgs/roles). Create an application in the Clerk Dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in

# One-time Super Admin bootstrap (min 16 chars). Disable/rotate after first use.
BOOTSTRAP_SECRET=change-me-bootstrap-secret

# AES-256-GCM field encryption key (64 hex chars). Generate: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=

# HMAC anti-replay for mutating API calls (64 hex chars). Generate: openssl rand -hex 32
# Used by Nest + the Next.js /api/backend proxy (server-only — never NEXT_PUBLIC_).
REQUEST_INTEGRITY_SECRET=

# Optional lockout tuning
SECURITY_FAIL_LIMIT=8
SECURITY_FAIL_WINDOW_MS=900000
SECURITY_BAN_MS=3600000

# Express "trust proxy" setting for reading X-Forwarded-For. Defaults to
# "loopback, linklocal, uniquelocal" (only trust the header from a private/
# docker-network peer, i.e. the Next.js BFF). Only widen this if a real
# reverse proxy/load balancer with a stable address sits in front of the API.
TRUSTED_PROXIES=

# Clerk Hobby (free) does not include MFA. Set true only after upgrading to Pro.
MFA_ENFORCEMENT_ENABLED=false

# Odds feed (API-Football). Leave the key empty to turn the feed off.
API_FOOTBALL_KEY=
# Default reaches api-sports.io directly. Set to api-football-v1.p.rapidapi.com
# to use the same data through a RapidAPI subscription instead (same
# API_FOOTBALL_KEY field, just the RapidAPI key) — auto-detected from the host.
# API_FOOTBALL_HOST=v3.football.api-sports.io
# Local testing only: made-up matches when there is no key.
ODDS_FEED_MOCK=false
# Basketball (API-Sports, same account as API-Football, its own 100 requests a
# day on the free plan, yesterday to tomorrow only). Uses API_FOOTBALL_KEY
# unless BASKETBALL_API_KEY is set; BASKETBALL_FEED=off turns it off.
# API-Sports has no NBA prices, so they come from The Odds API (free key at
# the-odds-api.com, 500 credits a month; NBA prices every 6 hours use ~360).
# NBA_ODDS_SPORTS=basketball_nba,basketball_nba_preseason
ODDS_API_KEY=
# BASKETBALL_LEAGUES=12,120,198,52,117,104,45,2,40,59
# NFL (API-Sports American football, same account as API-Football, its own
# 100 requests a day on the free plan, yesterday to tomorrow only). Uses
# API_FOOTBALL_KEY unless NFL_API_KEY is set; NFL_FEED=off turns it off.
# NFL_LEAGUES=1
# Volleyball and handball (API-Sports, same account as API-Football, each its
# own 100 requests a day on the free plan). Use API_FOOTBALL_KEY unless
# VOLLEYBALL_API_KEY / HANDBALL_API_KEY is set; VOLLEYBALL_FEED=off or
# HANDBALL_FEED=off turns one off. The default leagues are in
# apps/api/src/odds/team-sports-sync.service.ts.
# VOLLEYBALL_LEAGUES=248,97,113
# HANDBALL_LEAGUES=131,39,34
# MMA (API-Sports, same account as API-Football; its own 100 requests a day
# on the free plan, which only sees yesterday to tomorrow). Uses
# API_FOOTBALL_KEY unless set; MMA_FEED=off turns it off.
# MMA_API_KEY=
# MMA_SYNC_INTERVAL_MS=7200000
# Tennis (API-Tennis, api-tennis.com): ATP and WTA singles with prices and
# set scores. Leave empty to turn it off.
TENNIS_API_KEY=
# TENNIS_TOURS=Atp Singles,Wta Singles
# Greyhound racing (GreyhoundAPI, greyhoundapi.com). Leave empty to turn it off.
# A sandbox key (gapi_test_…) has race cards and results but no starting
# prices or dividends, so won race bets wait until a paid key is set.
GREYHOUND_API_KEY=
# GREYHOUND_REGIONS=GB,IE,AU
# Which competitions to sync (defaults cover ~60 worldwide; see README).
# API_FOOTBALL_LEAGUES=39,140,135
# API_FOOTBALL_COUNTRIES=Albania,Kosovo
# Requests kept back each day for live scores and results (default 8% of the
# plan, at least 600). Below it, only today's matches are refreshed and live
# prices and match stats stop until the count resets at midnight UTC.
# API_FOOTBALL_QUOTA_RESERVE=6000

# How often finished matches are checked and their bets paid out (ms). Default one minute.
# SETTLEMENT_INTERVAL_MS=60000
# Open bets on a match not played this many hours after kick-off (postponed,
# or moved to a later date) are refunded.
# UNPLAYED_VOID_HOURS=48
# Days (daily loss limits, charts) and weeks (commissions) start at midnight here.
# BUSINESS_TIME_ZONE=Europe/Tirane
# Super Admin's "Delete all test data" (Security page) deletes every other
# account, its Clerk sign-in and all its data. Set DATA_RESET=off once real
# users are in, so it can't be pressed by mistake.
# DATA_RESET=on
# Live betting: set LIVE_BETTING=off to turn it off. Live bets wait
# LIVE_BET_DELAY_MS before they're accepted (LIVE_BET_EVENTFUL_DELAY_MS on a busy
# match; longer, up to LIVE_BET_MAX_DELAY_MS, when the feed has lately been
# further behind than that: LIVE_BET_ADAPTIVE_DELAY=off keeps it fixed), and
# pause when the feed hasn't sent live prices for LIVE_ODDS_STALE_MS.
# LIVE_BETTING=on
# LIVE_BET_DELAY_MS=8000
# LIVE_BET_EVENTFUL_DELAY_MS=12000
# LIVE_BET_MAX_DELAY_MS=30000
# LIVE_BET_ADAPTIVE_DELAY=on
# LIVE_CHECK_TIMEOUT_MS=5000
# LIVE_ODDS_STALE_MS=90000
# The wait is at least the feed's delay on goals in the match's competition
# (LIVE_LAG_PERCENTILE of them within it) plus LIVE_LAG_MARGIN_MS; a competition
# slower than LIVE_BET_MAX_DELAY_MS, or a match with a goal that certainly came
# more than LIVE_SLOW_MATCH_MS late, takes no live bets.
# LIVE_LAG_PERCENTILE=0.95
# LIVE_LAG_MARGIN_MS=2000
# LIVE_SLOW_MATCH_MS=30000
# Late live bets are void (apps/api/src/bets/late.ts): placed from LATE_BUFFER_MS
# before a goal's real time on. A goal's time is taken as at least
# LATE_ASSUMED_LAG_MS before the site saw it (LATE_MAX_FEED_LAG_MS without its
# minute). Settled live bets of the last LATE_SWEEP_DAYS days that the rule in
# force never decided are checked again every 10 minutes (LATE_RECHECK_SWEEP=off
# stops that).
# LATE_BUFFER_MS=30000
# LATE_ASSUMED_LAG_MS=30000
# LATE_MAX_FEED_LAG_MS=120000
# LATE_RECHECK_SWEEP=on
# LATE_SWEEP_DAYS=7
# After the delay each live bet is checked with the feed itself (one request per
# live match on the slip); LIVE_VERIFY=off skips that. Live betting also pauses
# after a goal, a big jump in the match-result prices (LIVE_SWING_POINTS: 0.12 =
# a result's chance moving 12 points) and when the bookmaker reopens a blocked match, and closes from minute
# LIVE_CUTOFF_MINUTE (0 = never). Live prices are fetched every
# LIVE_ODDS_INTERVAL_MS while anyone is on the site (every 20 s otherwise) and
# live scores every ODDS_LIVE_INTERVAL_MS; both slow down by themselves when the
# day's requests wouldn't last at that speed.
# LIVE_VERIFY=on
# LIVE_GOAL_COOLDOWN_MS=90000
# LIVE_GOAL_MIN_PAUSE_MS=15000
# LIVE_SWING_COOLDOWN_MS=30000
# LIVE_REOPEN_COOLDOWN_MS=15000
# LIVE_SWING_POINTS=0.12
# LIVE_CUTOFF_MINUTE=89
# LIVE_ODDS_INTERVAL_MS=5000
# A goal, a card or a jump pauses only the markets it changes; each reopens on fresh prices after it
# (LIVE_GOAL_MIN_PAUSE_MS at least) or at the cooldowns above. Live betting only in competitions whose goals
# reach the site within LIVE_COMPETITION_MAX_LAG_MS at the 95th percentile (from LIVE_COMPETITION_MIN_GOALS;
# 0 = no limit); a market unpriced for LIVE_MARKET_STALE_MS during play leaves the live board. Matches with
# paused markets or open bets are read on their own every LIVE_ODDS_HOT_MS (LIVE_ODDS_HOT_MAX at a time),
# keeping API_FOOTBALL_MINUTE_RESERVE of each minute's requests back.
# LIVE_COMPETITION_MAX_LAG_MS=15000
# LIVE_COMPETITION_MIN_GOALS=5
# LIVE_MARKET_STALE_MS=300000
# LIVE_ODDS_HOT_MS=5000
# LIVE_ODDS_HOT_MAX=4
# API_FOOTBALL_MINUTE_RESERVE=0.2
# ODDS_LIVE_INTERVAL_MS=15000

# Old data is cleaned up every 6 hours. Bets, the balance ledger, commission
# payouts, audit logs and users are never deleted. Days to keep (minimums apply):
# RETENTION_ODDS_HISTORY_DAYS=7
# RETENTION_UNUSED_EVENT_DAYS=7
# RETENTION_READ_NOTIFICATION_DAYS=90
# RETENTION_NOTIFICATION_DAYS=180
# RETENTION_LOGIN_HISTORY_DAYS=180
# RETENTION_DISABLED=true
