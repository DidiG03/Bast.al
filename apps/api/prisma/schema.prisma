generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  PLAYER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum BalanceTransactionType {
  /// A real transfer down the hierarchy: fromUser's balance decreases,
  /// toUser's balance increases by the same amount.
  DELEGATION
  /// The reverse of a delegation: a parent pulls credit back from a direct
  /// child. fromUser is the child (balance decreases), toUser is the parent
  /// (balance increases, except Super Admin, who holds no balance — credit
  /// reclaimed by Super Admin is retired).
  RECLAIM
  /// Super-Admin-only correction. fromUserId is always null (nothing is
  /// deducted from anyone else); amount may be negative.
  ADJUSTMENT
}

enum NotificationType {
  FUNDS_RECEIVED
  FUNDS_RECLAIMED
  APPROVAL_REQUESTED
  ACCOUNT_SUSPENDED
  ACCOUNT_UPDATED
  ACCOUNT_REASSIGNED
  SUSPICIOUS_LOGIN
  COMMISSION_RATE_UPDATED
  LOW_BALANCE
}

enum NotificationCategory {
  FINANCE
  ACCOUNT
  SECURITY
  SYSTEM
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum BalanceTransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String     @id @default(cuid())
  clerkId   String     @unique @map("clerk_id")
  username  String     @unique
  /// AES-256-GCM ciphertext — never returned by API. Not unique (randomized IV).
  emailCipher String   @map("email_cipher")
  /// HMAC blind index for uniqueness/lookup without storing plaintext email.
  emailHash   String   @unique @map("email_hash")
  role      Role
  parentId  String?    @map("parent_id")
  parent    User?      @relation("UserHierarchy", fields: [parentId], references: [id])
  children  User[]     @relation("UserHierarchy")
  status    UserStatus @default(ACTIVE)
  /// Delegatable credit this user currently holds. Every role except
  /// SUPER_ADMIN carries a real balance in the delegation model — Super Admin
  /// "prints" credit into an Owner's balance with no source deduction.
  balance   Decimal    @default(0) @db.Decimal(12, 2)
  balanceLimit Decimal  @default(1000000) @map("balance_limit") @db.Decimal(12, 2)
  /// Max number of direct Players this user (Owner or Manager) may hold.
  managerCapacity Int    @default(100) @map("manager_capacity")
  /// Percentage this user's commission relationship with their parent runs
  /// at: for an OWNER, the cut Super Admin takes from their net revenue; for
  /// a MANAGER, the cut they earn from their own downline Players' net
  /// revenue. Unused for SUPER_ADMIN/PLAYER.
  commissionRate Decimal @default(0) @map("commission_rate") @db.Decimal(5, 2)
  /// MANAGER only: this Manager's own delegations up to this amount go through
  /// without their Owner's approval. Null means the platform default ($10,000).
  /// Set by the Manager's Owner (or Super Admin).
  approvalLimit Decimal? @map("approval_limit") @db.Decimal(12, 2)
  /// OWNER only: the approval limit every Manager in this team gets unless
  /// they have their own approvalLimit. Null means the platform default.
  managerApprovalLimit Decimal? @map("manager_approval_limit") @db.Decimal(12, 2)
  /// OWNER only: alert when a Manager or Player in this team drops below this
  /// balance. Null turns low-balance alerts off.
  lowBalanceThreshold Decimal? @map("low_balance_threshold") @db.Decimal(12, 2)
  /// OWNER only: percent added to Super Admin's base margin for this team's
  /// prices. Negative gives the team better odds, but never above the feed.
  oddsMargin Decimal @default(0) @map("odds_margin") @db.Decimal(5, 2)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  auditLogsAsActor  AuditLog[] @relation("AuditActor")
  auditLogsAsTarget AuditLog[] @relation("AuditTarget")
  delegationsGiven     BalanceTransaction[] @relation("DelegationFrom")
  delegationsReceived  BalanceTransaction[] @relation("DelegationTo")
  delegationsActedOn   BalanceTransaction[] @relation("DelegationActor")
  delegationsApproved  BalanceTransaction[] @relation("DelegationApprover")
  notifications                Notification[]
  notificationPreference      NotificationPreference?
  loginHistory                 LoginHistory[]
  bets                         Bet[]
  bettingLimit                 BettingLimit?
  oddsOverrides                OddsOverride[]

  @@index([parentId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model LoginHistory {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String   @unique @map("session_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  device      String?
  browser     String?
  location    String?
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("login_history")
}

model SecuritySetting {
  id          String   @id @default("default")
  failLimit   Int      @default(8) @map("fail_limit")
  windowMs    Int      @default(900000) @map("window_ms")
  banMs       Int      @default(3600000) @map("ban_ms")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("security_settings")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  category  NotificationCategory @default(SYSTEM)
  severity  NotificationSeverity @default(INFO)
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?        @map("read_at")
  archivedAt DateTime?       @map("archived_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, readAt, archivedAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inAppEnabled    Boolean  @default(true) @map("in_app_enabled")
  emailEnabled    Boolean  @default(false) @map("email_enabled")
  financeEnabled  Boolean  @default(true) @map("finance_enabled")
  accountEnabled  Boolean  @default(true) @map("account_enabled")
  securityEnabled Boolean  @default(true) @map("security_enabled")
  systemEnabled   Boolean  @default(true) @map("system_enabled")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

/// A single entry in the delegation ledger. DELEGATION rows always have
/// fromUserId set (a real transfer, one-directional — the giver's balance
/// decreases, the receiver's increases). ADJUSTMENT rows have fromUserId
/// null (a Super-Admin-only correction with no counterparty) and amount may
/// be negative.
model BalanceTransaction {
  id           String   @id @default(cuid())
  fromUserId   String?  @map("from_user_id")
  fromUser     User?    @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUserId     String   @map("to_user_id")
  toUser       User     @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)
  actorId      String?  @map("actor_id")
  actor        User?    @relation("DelegationActor", fields: [actorId], references: [id], onDelete: SetNull)
  approvedById String?  @map("approved_by_id")
  approvedBy   User?    @relation("DelegationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  type         BalanceTransactionType
  amount       Decimal  @db.Decimal(12, 2)
  reason       String
  status       BalanceTransactionStatus @default(APPROVED)
  approvedAt   DateTime? @map("approved_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([toUserId, createdAt])
  @@index([fromUserId])
  @@index([status])
  @@map("balance_transactions")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  action    String
  targetId  String?  @map("target_id")
  target    User?    @relation("AuditTarget", fields: [targetId], references: [id])
  ipAddress String?  @map("ip_address")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Event {
  id         String      @id @default(cuid())
  name       String
  league     String
  status     EventStatus @default(UPCOMING)
  startsAt   DateTime
  volume     Decimal     @default(0) @db.Decimal(12, 2)
  /// Where the match came from: "api-football", "mock" or "manual".
  provider   String      @default("manual")
  /// The match's id at the provider. Null for manual events.
  externalId String?     @map("external_id")
  country    String?
  homeTeam   String?     @map("home_team")
  awayTeam   String?     @map("away_team")
  homeScore  Int?        @map("home_score")
  awayScore  Int?        @map("away_score")
  /// Minutes played, while live.
  elapsed    Int?
  /// Super Admin: hidden events aren't shown to anyone else.
  hidden     Boolean     @default(false)
  /// Super Admin: suspended events are shown but can't be bet on.
  suspended  Boolean     @default(false)
  /// Last time the provider sent anything for this event.
  syncedAt   DateTime?   @map("synced_at")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  markets    Market[]

  @@unique([provider, externalId])
  @@index([status, startsAt])
}

/// One bet type on an event, e.g. "Match winner" or "Total goals 2.5".
model Market {
  id         String      @id @default(cuid())
  eventId    String      @map("event_id")
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Stable key such as "match_winner" or "goals_2_5".
  key        String
  name       String
  sortOrder  Int         @default(0) @map("sort_order")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  selections Selection[]

  @@unique([eventId, key])
  @@map("markets")
}

/// One outcome in a market, e.g. "Home" or "Over 2.5".
model Selection {
  id        String           @id @default(cuid())
  marketId  String           @map("market_id")
  market    Market           @relation(fields: [marketId], references: [id], onDelete: Cascade)
  /// Stable key such as "home", "draw" or "over".
  key       String
  name      String
  /// The price from the feed, before any margin or override.
  feedOdds  Decimal          @map("feed_odds") @db.Decimal(8, 2)
  /// Set when the market is settled.
  result    SelectionResult?
  sortOrder Int              @default(0) @map("sort_order")
  updatedAt DateTime         @updatedAt @map("updated_at")
  overrides OddsOverride[]
  bets      Bet[]

  @@unique([marketId, key])
  @@map("selections")
}

enum SelectionResult {
  WON
  LOST
  VOID
}

/// An Owner's own price for one selection. Applies to their team only and
/// replaces the margin-adjusted feed price.
model OddsOverride {
  ownerId     String    @map("owner_id")
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  selectionId String    @map("selection_id")
  selection   Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  odds        Decimal   @db.Decimal(8, 2)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@id([ownerId, selectionId])
  @@index([selectionId])
  @@map("odds_overrides")
}

/// Platform-wide settings. There is one row, with id "default".
model PlatformSettings {
  id             String    @id @default("default")
  /// Super Admin's margin, in percent, taken off every feed price for every team.
  baseOddsMargin Decimal   @default(0) @map("base_odds_margin") @db.Decimal(5, 2)
  /// When the odds feed last finished a sync, and what it reported.
  oddsSyncedAt   DateTime? @map("odds_synced_at")
  oddsSyncStatus String?   @map("odds_sync_status") @db.VarChar(300)
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// A Player's bet. Commission reporting reads only settled bets (WON/LOST):
/// the house's net revenue from a bet is stake - payout, so a lost bet
/// earns the full stake and a won bet costs the winnings. VOID bets are
/// refunded and count for nothing.
model Bet {
  id        String    @id @default(cuid())
  playerId  String    @map("player_id")
  player    User      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  stake     Decimal   @db.Decimal(12, 2)
  /// What the Player was paid back, stake included. 0 for a lost bet.
  payout    Decimal   @default(0) @db.Decimal(12, 2)
  status    BetStatus @default(OPEN)
  /// What was bet on, e.g. "Tirana v Partizani · Tirana to win".
  description String?  @db.VarChar(200)
  /// The price the Player got, locked when the bet was placed.
  odds      Decimal?  @db.Decimal(8, 2)
  selectionId String?    @map("selection_id")
  selection   Selection? @relation(fields: [selectionId], references: [id], onDelete: Restrict)
  placedAt  DateTime  @default(now()) @map("placed_at")
  settledAt DateTime? @map("settled_at")

  @@index([playerId, settledAt])
  @@index([status, settledAt])
  @@index([selectionId])
  @@map("bets")
}

/// Per-Player betting limits in two layers. The Owner (or Super Admin) sets
/// the ceiling; the Player's Manager can only tighten it. The limit that
/// applies is the lower of the two for each value. Null means no limit.
model BettingLimit {
  playerId              String   @id @map("player_id")
  player                User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  ownerMaxStake         Decimal? @map("owner_max_stake") @db.Decimal(12, 2)
  ownerDailyLossLimit   Decimal? @map("owner_daily_loss_limit") @db.Decimal(12, 2)
  managerMaxStake       Decimal? @map("manager_max_stake") @db.Decimal(12, 2)
  managerDailyLossLimit Decimal? @map("manager_daily_loss_limit") @db.Decimal(12, 2)
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("betting_limits")
}

enum BetStatus {
  OPEN
  WON
  LOST
  VOID
}

enum EventStatus {
  LIVE
  UPCOMING
  COMPLETED
  POSTPONED
  CANCELLED
}

/// One row per client-supplied Idempotency-Key, so a double tap or a retried
/// request replays the first response instead of moving money twice.
model IdempotencyKey {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  key            String
  requestHash    String   @map("request_hash")
  completed      Boolean  @default(false)
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}
